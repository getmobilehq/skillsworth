# Prove Your Worth — environment (handoff §17)
# Copy to .env.local and fill in. Never commit real values.
# Everything below is SERVER ONLY unless prefixed NEXT_PUBLIC_.

# Postgres — Neon in production. Use the POOLED connection string (host has
# "-pooler") for the app; the UNPOOLED one for migrations (npm run db:migrate).
# Locally, any Postgres works, e.g. a Neon dev branch or
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth — sessions. Secret: `openssl rand -base64 32`. URL = the app origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Phone OTP — Twilio Verify (handoff §9). Leave unset locally: in dev the code
# 123456 verifies any number. In production, unset = signup fails loudly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Anthropic — server only. (handoff §4, §8)
ANTHROPIC_API_KEY=

# raffu (§19 resolved: cross-project direct insert with raffu's ANON key).
# Point these at raffu's OWN Supabase project. raffu still runs on Supabase;
# skillsworth itself no longer does. Leave unset to no-op (entries still
# mirrored locally in raffle_entries).
RAFFU_SUPABASE_URL=
RAFFU_SUPABASE_ANON_KEY=

# raffu — OPS ONLY (scripts/ensure-weekly-raffle.mjs). NOT used by the running
# app. Creating the weekly raffle needs raffu's owner RLS, hence the
# service-role key + the TTS admin's raffu user id. Keep out of the runtime env.
RAFFU_SERVICE_ROLE_KEY=
RAFFU_OWNER_ID=

# Email (Resend) — server only
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
